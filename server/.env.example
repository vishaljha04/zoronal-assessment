# MongoDB Connection String (use MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb://localhost:27017/reviewly

# Server Port
PORT=5000

# CORS Origin (for production, set to your frontend URL)
CORS_ORIGIN=http://localhost:5173

# OR: comma-separated list of allowed origins (recommended)
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
